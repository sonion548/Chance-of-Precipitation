{"nodes": [{"id": "projectstate_soneybun", "label": "SONEYBUN \u2014 Descent Protocol (Project State)", "file_type": "document", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_coop_authority_split", "label": "Split Co-op Authority Model", "file_type": "rationale", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The host owns the world (arena seed, director, enemies, bosses, chests, beacon); every player owns themselves (position, items, gold, level, pets). A client resolves its own hits locally and reports the number to the host; the host sends raw incoming damage and the client's own machine applies its armour/barrier/items, so a build is only ever evaluated where it lives. Trusting peers is deliberate: this is a game hosted for friends off a code read aloud."}, {"id": "projectstate_combat_damageenemy", "label": "Combat.damageEnemy Single Entry Point", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_proc_coefficients", "label": "Proc Coefficients", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_items_declarative", "label": "Declarative Item System (stats/hooks)", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_party_scaling", "label": "PARTY Co-op Scaling Config", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_performance_lighting_bug", "label": "Never Toggle visible on a Light", "file_type": "rationale", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "three.js bakes the visible light count into every material's shader, so toggling a PointLight's visible property recompiles every material in the scene; explosions did this several times a second and program count passed 110, costing hundreds of ms per frame. Fix: allocate lights once and animate intensity to zero instead of toggling visibility."}, {"id": "projectstate_broadphase_collision", "label": "Broadphase Collision Grid", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_mergestaticmeshes", "label": "mergeStaticMeshes (sub-mesh merging)", "file_type": "concept", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projectstate_object3d_add_bug", "label": "Object3D.add Returns Parent, Not Child", "file_type": "rationale", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "head.add(mesh).position.set(...) reads like it positions the mesh, but Object3D.add returns the parent, so the line relocated the whole head to the antenna tip's coordinates, placing it inside the torso \u2014 the character appeared to have no head."}, {"id": "projectstate_test_harness_lessons", "label": "Test-Harness Lessons (harnesses lie, measure before optimizing)", "file_type": "rationale", "source_file": "PROJECTSTATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 'grapple does nothing' result was actually the test harness holding a key for two frames and firing twice; a scary damage number was two overlapping floating combat-text instances; an FPS complaint traced to shader recompilation, not geometry \u2014 underscoring 'measure before optimising'."}], "edges": [{"source": "projectstate_soneybun", "target": "readme_soneybun", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_combat_damageenemy", "target": "readme_soneybun", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_party_scaling", "target": "readme_coop_lobby", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_proc_coefficients", "target": "readme_weapons", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_object3d_add_bug", "target": "readme_characters", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_performance_lighting_bug", "target": "readme_performance", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_broadphase_collision", "target": "readme_performance", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_mergestaticmeshes", "target": "readme_performance", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}, {"source": "projectstate_coop_authority_split", "target": "projectstate_soneybun", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECTSTATE.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "soneybun_coop_authority_hyperedge", "label": "SONEYBUN Co-op Authority Design", "nodes": ["projectstate_coop_authority_split", "projectstate_combat_damageenemy", "projectstate_party_scaling"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PROJECTSTATE.md"}]}