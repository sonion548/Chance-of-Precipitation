# The source is LF; graphify writes its artifacts with CRLF on Windows. Declare
# both so a checkout on any machine leaves each exactly as the producing tool
# wrote it, instead of rewriting every line of a 3 MB graph on the first commit.
* text=auto eol=lf
graph/** -text

# graph/ is generated (see graph/README.md) and vendor/ is somebody else's
# three.js build. Marking them keeps both out of GitHub's language stats and
# collapses them in diffs, so a pull request shows the source that actually moved.
graph/**   linguist-generated=true
vendor/**  linguist-vendored=true

# play.cmd is run by cmd.exe, which wants CRLF — a batch file checked out with
# LF endings mis-parses its own labels. play.sh is the opposite and stays LF.
play.cmd text eol=crlf
play.sh  text eol=lf
